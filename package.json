{
  "name": "portfolio-be",
  "private": true,
  "scripts": {
    "start": "node dist/src/main.js",
    "start:watch": "node --watch dist/src/main.js",
    "dev": "npm run clean:dist && npm run db:generate && concurrently -k --raw \"npm run build:watch\" \"wait-on --log file:dist/src/main.js && npm run start:watch\"",
    "clean:dist": "rimraf dist",
    "build": "tsc --project tsconfig.json",
    "build:clean": "npm run clean:dist && tsc --project tsconfig.json",
    "build:watch": "npm run build -- --watch",
    "prisma": "prisma",
    "db:migrate": "npm run prisma -- migrate deploy",
    "db:migrate:dev": "npm run prisma -- migrate dev",
    "db:generate": "npm run prisma -- generate",
    "db:seed": "npm run prisma -- db seed",
    "db:studio": "npm run prisma -- studio",
    "db:reset": "npm run prisma -- migrate reset"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdsarun/portfolio-be.git"
  },
  "keywords": [],
  "author": "sdsarun",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sdsarun/portfolio-be/issues"
  },
  "homepage": "https://github.com/sdsarun/portfolio-be#readme",
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.2.1",
    "pino-pretty": "^13.1.3",
    "prettier": "3.7.4",
    "prisma": "^7.3.0",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@octokit/core": "^7.0.6",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.4.2",
    "argon2": "^0.44.0",
    "fastify": "^5.6.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "redis": "^5.10.0",
    "zod": "^4.2.1"
  }
}
